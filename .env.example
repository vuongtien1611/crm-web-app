# Node Environment
NODE_ENV=development
API_PORT=3000

# Database Configuration (PostgreSQL 16)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=crm_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_secret_dev
DATABASE_SSL=false

# Cache / Queue Configuration (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication Secrets (To be generated via Argon2id / OpenSSL)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars

# Cloud Storage Configuration (Cloudflare R2 - Production)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=crm-uploads
