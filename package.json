{
  "name": "crm-web-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter \"@crm/*\" build && pnpm --filter api build && pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "db:init": "docker compose exec -T postgres psql -U postgres -d crm_db -f /database/crm_order_schema.sql && docker compose exec -T postgres psql -U postgres -d crm_db -f /database/crm_seed.sql",
    "db:migrate": "pnpm --filter api db:migrate",
    "seed:staging": "pnpm --filter api seed:staging",
    "test:uat": "pnpm --filter api test:phase-s-uat",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "start:tunnel": "bash scripts/start-tunnel.sh",
    "stop:tunnel": "bash scripts/stop-tunnel.sh"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "rc-util@5.44.4": "patches/rc-util@5.44.4.patch"
    }
  }
}
